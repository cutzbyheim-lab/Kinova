# ─────────────────────────────────────────────────────────────
# KINOVA configuration
# Copy this file to `.env` (same folder) and fill in the keys.
# Never commit `.env` — it holds your secrets.
# ─────────────────────────────────────────────────────────────

# --- AI: Claude (Anthropic) ---------------------------------
# Get a key at https://platform.claude.com/ → API Keys.
# Without it, KINOVA still runs, but uses a clearly-labelled
# non-AI fallback planner and skips AI-written captions.
ANTHROPIC_API_KEY=

# Cheap model for routine work (captions, hooks, hashtags)
MODEL_FAST=claude-haiku-5-5
# Smarter model for editing plans
MODEL_SMART=claude-sonnet-5-5

# Hard spending cap per production job, in US dollars.
# A job stops calling Claude once it would go over this.
MAX_JOB_COST_USD=0.50

# --- Trends: YouTube Data API v3 -----------------------------
# Free key: https://console.cloud.google.com → APIs & Services →
# enable "YouTube Data API v3" → Credentials → Create API key.
YOUTUBE_API_KEY=
# Region for trend lookups (ISO country code)
YOUTUBE_REGION=US

# --- Stock B-roll: Pexels (free, commercial use allowed) -----
# Get a key at https://www.pexels.com/api/ (free account → "Your API Key").
PEXELS_API_KEY=

# --- Speech-to-text: open-source Whisper (runs locally, free) -
WHISPER_ENABLED=true
# tiny | base | small | medium  (bigger = better + slower)
WHISPER_MODEL=base

# --- Motion graphics (Remotion) -----------------------------
# Animated captions, hook titles, B-roll entrances and CTA. Uses headless Chrome
# inside the worker. Set to false to use the simpler (faster) FFmpeg-only look.
MOTION_ENABLED=true
# Parallel browser tabs while rendering. 0 = automatic (half your CPU cores, max 4).
MOTION_CONCURRENCY=0

# --- Limits --------------------------------------------------
MAX_UPLOAD_MB=1024
MAX_VIDEO_SECONDS=900

# --- Security ------------------------------------------------
# Used to sign private file links. Change to any long random string.
SECRET_KEY=change-me-to-a-long-random-string
